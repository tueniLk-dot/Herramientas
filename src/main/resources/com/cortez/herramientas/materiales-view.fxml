<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="718.0" prefWidth="1031.0" spacing="25.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cortez.herramientas.control.MaterialController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <children>
        <!-- Título de la sección -->
        <Label text="Gestión de Materials" textFill="#333333">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>

        <!-- Barra de Formulario y Acciones -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <TextField prefWidth="150.0" promptText="Ingresa ID" />
                <TextField prefWidth="350.0" promptText="Ingresar nombre" />

                <!-- Este Region empuja los botones hacia la derecha -->
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtId" promptText="ID" />
                <TextField fx:id="txtNombre" promptText="Nombre" />
                <!-- Botones de Acción -->
                <Button onMouseClicked="#handleLimpiar" mnemonicParsing="false" prefWidth="100.0" text="Limpiar" />
                <Button onMouseClicked="#handleEliminar" mnemonicParsing="false" prefWidth="100.0" text="Eliminar" />
                <Button onMouseClicked="#handleActualizar" mnemonicParsing="false" prefWidth="100.0" text="Actualizar" />
                <!-- Botón principal destacado con estilo inline simple -->
                <Button  prefWidth="100.0"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;"
                        text="Crear" onAction="#handleCrear"/>

            </children>
        </HBox>

        <!-- Tabla de Datos -->
        <TableView VBox.vgrow="ALWAYS">
            <columns>
                <!-- Tamaños proporcionales iniciales, la tabla ajustará el resto -->
                <TableColumn fx:id="ID"  prefWidth="150.0"  text="ID" />
                <TableColumn fx:id="Nombre" prefWidth="800.0" text="Nombre" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>